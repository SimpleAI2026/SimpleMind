{
  "manifest_version": 3,
  "name": "SimpleMind",
  "version": "0.1.0",
  "description": "Local mind maps powered by Chrome Built-in AI (Gemini Nano). No API keys.",
  "action": {
    "default_title": "SimpleMind",
    "default_icon": {
      "16": "favicon.ico",
      "32": "favicon.ico",
      "48": "favicon.ico"
    }
  },
  "icons": {
    "16": "favicon.ico",
    "32": "favicon.ico",
    "48": "favicon.ico",
    "128": "favicon.ico"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"]
}
